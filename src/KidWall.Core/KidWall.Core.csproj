<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <RootNamespace>KidWall.Core</RootNamespace>
    <AssemblyName>KidWall.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内嵌默认壁纸目录配置：运行目录 res/wallpapers.json 缺失时使用 -->
    <EmbeddedResource Include="..\..\res\wallpapers.json" LogicalName="KidWall.Core.wallpapers.json" />
  </ItemGroup>
</Project>
