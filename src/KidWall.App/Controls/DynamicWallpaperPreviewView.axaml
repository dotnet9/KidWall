<UserControl
    x:Class="KidWall.App.Controls.DynamicWallpaperPreviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidWall.App.Controls"
    xmlns:vlc="using:LibVLCSharp.Avalonia"
    Background="Transparent"
    ClipToBounds="True">
  <Grid ClipToBounds="True">
    <vlc:VideoView
        x:Name="PART_VideoView"
        IsVisible="{Binding IsVideoHostVisible, RelativeSource={RelativeSource AncestorType=controls:DynamicWallpaperPreviewView}}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch" />
    <!-- Keep the poster above the video until the first decoded frame. -->
    <Image
        Classes="wallpaper-media"
        x:Name="PART_Poster"
        IsVisible="{Binding IsPosterVisible, RelativeSource={RelativeSource AncestorType=controls:DynamicWallpaperPreviewView}}"
        Source="{Binding PosterSource, RelativeSource={RelativeSource AncestorType=controls:DynamicWallpaperPreviewView}}"
        Stretch="UniformToFill"
        RenderTransform="scale(1)"
        RenderTransformOrigin="50%,50%">
      <Image.Transitions>
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" />
        </Transitions>
      </Image.Transitions>
    </Image>
  </Grid>
</UserControl>
