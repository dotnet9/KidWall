<Window
    x:Class="KidWall.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KidWall.App.Behaviors"
    xmlns:controls="using:KidWall.App.Controls"
    xmlns:vm="using:KidWall.App.ViewModels"
    xmlns:views="using:KidWall.App.Views"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource KidWallWindowBackground}"
    Icon="/Assets/logo.ico"
    ExtendClientAreaTitleBarHeightHint="60"
    ExtendClientAreaToDecorationsHint="True"
    FontFamily="YouYuan, Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    Height="820"
    MinHeight="640"
    MinWidth="1000"
    Title="{Binding WindowTitle}"
    Width="1280"
    WindowDecorations="BorderOnly"
    behaviors:WindowCloseBehavior.IsEnabled="True"
    WindowStartupLocation="CenterScreen">
  <Panel>
    <Grid RowDefinitions="60,*">

      <!-- ================= 标题栏 ================= -->
      <Grid
          Grid.Row="0"
          Background="{DynamicResource KidWallTitlebarBrush}"
          behaviors:TitleBarDragBehavior.IsEnabled="True">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <!-- 品牌区 -->
          <StackPanel
              Margin="16,0,0,0"
              Orientation="Horizontal"
              Spacing="10"
              VerticalAlignment="Center">
            <Border Classes="brand-mark">
              <TextBlock
                  HorizontalAlignment="Center"
                  Text="🎈"
                  VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Classes="win-title" Text="{Binding WindowTitle}" />
              <TextBlock Classes="win-subtitle" Text="{Binding WindowSubtitle}" />
            </StackPanel>
          </StackPanel>

          <!-- 搜索框 -->
          <Grid Grid.Column="1" MaxWidth="440" VerticalAlignment="Center">
            <TextBox
                Classes="search"
                Padding="38,4,14,4"
                Text="{Binding SearchText, Mode=TwoWay}"
                VerticalAlignment="Center"
                PlaceholderText="{Binding SearchPlaceholder}" />
            <TextBlock
                Margin="14,0,0,0"
                FontSize="16"
                IsHitTestVisible="False"
                Text="🔎"
                VerticalAlignment="Center" />
          </Grid>

          <!-- 右侧操作区 -->
          <StackPanel
              Grid.Column="2"
              Margin="0,0,10,0"
              Orientation="Horizontal"
              Spacing="8"
              VerticalAlignment="Center">
            <Button Classes="secondary-btn" Command="{Binding PickLocalFolderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="📁" />
                <TextBlock Text="{Binding LocalButtonText}" />
              </StackPanel>
            </Button>
            <Button Classes="primary-btn" Command="{Binding ToggleSettingsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="⚙" />
                <TextBlock Text="{Binding SettingsButtonText}" />
              </StackPanel>
            </Button>

            <Button
                Classes="candy moon"
                Command="{Binding MinimizeWindowCommand}"
                ToolTip.Tip="{Binding MinimizeTip}">
              <TextBlock Text="🌙" />
            </Button>
            <Button
                Classes="candy star"
                Command="{Binding ToggleMaximizeWindowCommand}"
                ToolTip.Tip="{Binding MaximizeTip}">
              <TextBlock Text="⭐" />
            </Button>
            <Button
                Classes="candy hand"
                Command="{Binding CloseWindowCommand}"
                ToolTip.Tip="{Binding CloseTip}">
              <TextBlock Text="👋" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ================= 内容区 ================= -->
      <views:MainView Grid.Row="1" />

      <!-- ================= 预览层 ================= -->
      <Border
          IsVisible="{Binding IsPreviewOpen}"
          Background="#990A1628"
          Grid.RowSpan="2"
          ZIndex="300">
        <Grid>
          <Button
              Background="Transparent"
              BorderThickness="0"
              Command="{Binding ClosePreviewCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
          <Border
              Classes="surface-panel"
              HorizontalAlignment="Center"
              Margin="0,16,0,0"
              Width="760"
              ZIndex="1">
            <Grid RowDefinitions="Auto,Auto">
              <Border
                  Grid.Row="0"
                  Height="428"
                  Margin="18,54,18,10"
                  Background="#12000000"
                  BorderBrush="{DynamicResource KidWallBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  CornerRadius="20">
                <Grid>
                  <controls:DynamicWallpaperPreviewView
                      IsHitTestVisible="False"
                      Margin="8"
                      MediaPath="{Binding PreviewItem.PreviewMediaPath}"
                      PosterSource="{Binding PreviewItem.Preview}"
                      AutoPlay="{Binding PreviewItem.IsDynamic}"
                      EnableHoverPreview="False"
                      Loop="True" />
                  <Border
                      Background="{DynamicResource CardShadeBrush}"
                      Height="82"
                      VerticalAlignment="Bottom" />
                  <Border
                      Classes="badge"
                      IsVisible="{Binding PreviewItem.IsDynamic}"
                      Margin="16"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Classes="badge-dot" VerticalAlignment="Center" />
                      <TextBlock Classes="badge" Text="{Binding DynamicBadgeText}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid
                  Grid.Row="1"
                  Margin="18,0,18,18"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="panel-title" Text="{Binding PreviewItem.Name}" />
                  <TextBlock Classes="panel-sub" Text="{Binding PreviewItem.DisplayTags}" />
                  <TextBlock Classes="panel-sub" Text="{Binding PreviewResolution}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="secondary-btn"
                    Command="{Binding ToggleFavoriteCommand}"
                    CommandParameter="{Binding PreviewItem}">
                  <TextBlock Text="{Binding PreviewItem.FavoriteText}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Classes="primary-btn"
                    Command="{Binding ApplyWallpaperCommand}"
                    CommandParameter="{Binding PreviewItem}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="✨" />
                    <TextBlock Text="{Binding ApplyWallpaperText}" />
                  </StackPanel>
                </Button>
              </Grid>
              <!-- Reserve a header strip so the close button stays outside the native video HWND. -->
              <Button
                  Grid.RowSpan="2"
                  Classes="candy hand"
                  Command="{Binding ClosePreviewCommand}"
                  CornerRadius="17"
                  Height="34"
                  HorizontalAlignment="Right"
                  Margin="0,8,16,0"
                  VerticalAlignment="Top"
                  Width="34"
                  ZIndex="10">
                <TextBlock FontSize="13" Text="✕" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ================= 设置层 ================= -->
      <Border
          IsVisible="{Binding IsSettingsOpen}"
          Background="#660A1628"
          Grid.RowSpan="2"
          ZIndex="250">
        <Grid>
          <Button
              Background="Transparent"
              BorderThickness="0"
              Command="{Binding ToggleSettingsCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
          <Border
              Classes="surface-panel"
              CornerRadius="18,0,0,18"
              HorizontalAlignment="Right"
              Margin="0"
              Width="380"
              ZIndex="1">
            <StackPanel Margin="26,22">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="panel-title" Text="{Binding SettingsTitle}" />
                <Button
                    Grid.Column="1"
                    Classes="secondary-btn"
                    Command="{Binding ToggleSettingsCommand}"
                    Padding="8,4"
                    ToolTip.Tip="关闭设置">
                  <TextBlock Text="✕" />
                </Button>
              </Grid>
              <TextBlock
                  Classes="panel-sub"
                  Margin="0,4,0,20"
                  Text="{Binding SettingsSubtitle}" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding AutoStartTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding AutoStartDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding AutoStart, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding AutoRotateTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding AutoRotateDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding AutoRotate, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding BatterySaverTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding BatterySaverDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding BatterySaver, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding ContentFilterTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding ContentFilterDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding ContentFilter, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Button
                  Classes="primary-btn"
                  HorizontalAlignment="Stretch"
                  Margin="0,28,0,0"
                  Command="{Binding SaveSettingsCommand}">
                <TextBlock Text="{Binding SaveSettingsText}" />
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- ================= 消息提示 ================= -->
      <Border
          IsVisible="{Binding IsStatusVisible}"
          Background="#E6140C3C"
          BorderBrush="{DynamicResource KidWallAccentBrush}"
          BorderThickness="1"
          CornerRadius="20"
          HorizontalAlignment="Center"
          Padding="20,10"
          VerticalAlignment="Bottom"
          Grid.RowSpan="2"
          ZIndex="400">
        <TextBlock
            FontSize="13"
            Foreground="White"
            Text="{Binding StatusMessage}" />
      </Border>
    </Grid>

    <!-- 窗口顶部品牌渐变线 -->
    <Border
        Background="{DynamicResource KidWallAccentGradientBrush}"
        Height="3"
        IsHitTestVisible="False"
        VerticalAlignment="Top"
        ZIndex="99" />
  </Panel>
</Window>
