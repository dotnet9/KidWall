<Window
    x:Class="KidWall.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KidWall.App.ViewModels"
    xmlns:views="using:KidWall.App.Views"
    xmlns:ac="using:Avalonia.Data.Converters"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource KidWallWindowBackground}"
    ExtendClientAreaTitleBarHeightHint="60"
    ExtendClientAreaToDecorationsHint="True"
    FontFamily="YouYuan, Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
    Height="820"
    MinHeight="640"
    MinWidth="1000"
    Title="{Binding WindowTitle}"
    Width="1280"
    WindowDecorations="BorderOnly"
    WindowStartupLocation="CenterScreen">
  <Panel>
    <Grid RowDefinitions="60,*">

      <!-- ================= 标题栏 ================= -->
      <Grid
          Grid.Row="0"
          Background="{DynamicResource KidWallTitlebarBrush}"
          DoubleTapped="OnTitleBarDoubleTapped"
          PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <!-- 品牌区 -->
          <StackPanel
              Margin="16,0,0,0"
              Orientation="Horizontal"
              Spacing="10"
              VerticalAlignment="Center">
            <Border Classes="brand-mark">
              <TextBlock
                  HorizontalAlignment="Center"
                  Text="🎈"
                  VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Classes="win-title" Text="{Binding WindowTitle}" />
              <TextBlock Classes="win-subtitle" Text="{Binding WindowSubtitle}" />
            </StackPanel>
          </StackPanel>

          <!-- 搜索框 -->
          <TextBox
              Grid.Column="1"
              Classes="search"
              MaxWidth="440"
              Text="{Binding SearchText, Mode=TwoWay}"
              VerticalAlignment="Center"
              PlaceholderText="{Binding SearchPlaceholder}" />

          <!-- 右侧操作区 -->
          <StackPanel
              Grid.Column="2"
              Margin="0,0,10,0"
              Orientation="Horizontal"
              Spacing="8"
              VerticalAlignment="Center">
            <Button Classes="secondary-btn" Click="OnPickLocalFolderClick">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="📁" />
                <TextBlock Text="{Binding LocalButtonText}" />
              </StackPanel>
            </Button>
            <Button Classes="primary-btn" Command="{Binding ToggleSettingsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="⚙" />
                <TextBlock Text="{Binding SettingsButtonText}" />
              </StackPanel>
            </Button>

            <Button
                Classes="candy moon"
                Click="OnMinimizeClick"
                ToolTip.Tip="{Binding MinimizeTip}">
              <TextBlock Text="🌙" />
            </Button>
            <Button
                Classes="candy star"
                Click="OnMaximizeClick"
                ToolTip.Tip="{Binding MaximizeTip}">
              <TextBlock Text="⭐" />
            </Button>
            <Button
                Classes="candy hand"
                Click="OnCloseClick"
                ToolTip.Tip="{Binding CloseTip}">
              <TextBlock Text="👋" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ================= 内容区 ================= -->
      <views:MainView Grid.Row="1" />

      <!-- ================= 预览层 ================= -->
      <Border
          IsVisible="{Binding PreviewItem, Converter={x:Static ac:ObjectConverters.IsNotNull}}"
          Background="#990A1628"
          ZIndex="300">
        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Classes="surface-panel" Width="880">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid
                  Grid.Row="0"
                  Margin="18,12,10,4"
                  ColumnDefinitions="*,Auto">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                  <TextBlock Classes="panel-title" Text="{Binding PreviewItem.Name}" />
                  <Border
                      Classes="badge"
                      IsVisible="{Binding PreviewItem.IsDynamic}"
                      VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Classes="badge-dot" VerticalAlignment="Center" />
                      <TextBlock Classes="badge" Text="{Binding DynamicBadgeText}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="candy hand"
                    Click="OnClosePreviewClick"
                    CornerRadius="15"
                    Height="30"
                    Width="30">
                  <TextBlock FontSize="12" Text="✕" />
                </Button>
              </Grid>

              <Border
                  Grid.Row="1"
                  Margin="18,6,18,10"
                  Background="#00000000"
                  BorderBrush="{DynamicResource KidWallBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  CornerRadius="14">
                <Grid>
                  <Image
                      Source="{Binding PreviewItem.Preview}"
                      Stretch="UniformToFill" />
                  <!-- 动态壁纸：叠加呼吸光晕提示播放（桌面播放由 WorkerW + LibVLC 实现） -->
                  <Border Classes="dyn-overlay" IsVisible="{Binding PreviewItem.IsDynamic}" />
                  <Border
                      Background="{DynamicResource CardShadeBrush}"
                      VerticalAlignment="Bottom">
                    <StackPanel
                        Margin="16,24,16,14"
                        Orientation="Horizontal"
                        Spacing="12">
                      <TextBlock Classes="card-tag" Text="{Binding PreviewItem.Tags}" />
                      <TextBlock Classes="card-tag" Text="{Binding PreviewResolution}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <StackPanel
                  Grid.Row="2"
                  Margin="0,0,0,14"
                  HorizontalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="12">
                <Button
                    Classes="secondary-btn"
                    Command="{Binding ToggleFavoriteCommand}"
                    CommandParameter="{Binding PreviewItem}">
                  <TextBlock Text="{Binding PreviewItem.FavoriteText}" />
                </Button>
                <Button Classes="primary-btn" Command="{Binding ApplyWallpaperCommand}" CommandParameter="{Binding PreviewItem}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="✨" />
                    <TextBlock Text="{Binding ApplyWallpaperText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Panel>
      </Border>

      <!-- ================= 设置层 ================= -->
      <Border
          IsVisible="{Binding IsSettingsOpen}"
          Background="#660A1628"
          ZIndex="250">
        <Border
            Classes="surface-panel"
            CornerRadius="18,0,0,18"
            HorizontalAlignment="Right"
            Margin="0,60,0,0"
            Width="390">
          <StackPanel Margin="26,22">
            <TextBlock Classes="panel-title" Text="{Binding SettingsTitle}" />
            <TextBlock
                Classes="panel-sub"
                Margin="0,4,0,20"
                Text="{Binding SettingsSubtitle}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
              <StackPanel Spacing="2">
                <TextBlock Classes="setting-title" Text="{Binding AutoStartTitle}" />
                <TextBlock Classes="setting-desc" Text="{Binding AutoStartDesc}" />
              </StackPanel>
              <ToggleSwitch
                  Grid.Column="1"
                  IsChecked="{Binding AutoStart, Mode=TwoWay}"
                  OnContent=""
                  OffContent="" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
              <StackPanel Spacing="2">
                <TextBlock Classes="setting-title" Text="{Binding AutoRotateTitle}" />
                <TextBlock Classes="setting-desc" Text="{Binding AutoRotateDesc}" />
              </StackPanel>
              <ToggleSwitch
                  Grid.Column="1"
                  IsChecked="{Binding AutoRotate, Mode=TwoWay}"
                  OnContent=""
                  OffContent="" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
              <StackPanel Spacing="2">
                <TextBlock Classes="setting-title" Text="{Binding BatterySaverTitle}" />
                <TextBlock Classes="setting-desc" Text="{Binding BatterySaverDesc}" />
              </StackPanel>
              <ToggleSwitch
                  Grid.Column="1"
                  IsChecked="{Binding BatterySaver, Mode=TwoWay}"
                  OnContent=""
                  OffContent="" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
              <StackPanel Spacing="2">
                <TextBlock Classes="setting-title" Text="{Binding ContentFilterTitle}" />
                <TextBlock Classes="setting-desc" Text="{Binding ContentFilterDesc}" />
              </StackPanel>
              <ToggleSwitch
                  Grid.Column="1"
                  IsChecked="{Binding ContentFilter, Mode=TwoWay}"
                  OnContent=""
                  OffContent="" />
            </Grid>

            <Button
                Classes="primary-btn"
                HorizontalAlignment="Stretch"
                Margin="0,28,0,0"
                Command="{Binding SaveSettingsCommand}">
              <TextBlock Text="{Binding SaveSettingsText}" />
            </Button>
          </StackPanel>
        </Border>
      </Border>

      <!-- ================= 消息提示 ================= -->
      <Border
          IsVisible="{Binding StatusMessage, Converter={x:Static ac:ObjectConverters.IsNotNull}}"
          Background="#E6140C3C"
          BorderBrush="{DynamicResource KidWallAccentBrush}"
          BorderThickness="1"
          CornerRadius="20"
          HorizontalAlignment="Center"
          Padding="20,10"
          VerticalAlignment="Bottom"
          ZIndex="400">
        <TextBlock
            FontSize="13"
            Foreground="White"
            Text="{Binding StatusMessage}" />
      </Border>
    </Grid>

    <!-- 窗口顶部品牌渐变线 -->
    <Border
        Background="{DynamicResource KidWallAccentGradientBrush}"
        Height="3"
        IsHitTestVisible="False"
        VerticalAlignment="Top"
        ZIndex="99" />
  </Panel>
</Window>
