<codewf:CodeWFWindow
    x:Class="KidWall.App.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:KidWall.App.Behaviors"
    xmlns:codewf="https://codewf.com"
    xmlns:controls="using:KidWall.App.Controls"
    xmlns:vm="using:KidWall.App.ViewModels"
    xmlns:views="using:KidWall.App.Views"
    xmlns:l="using:Localization"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel"
    Background="{DynamicResource KidWallWindowBackground}"
    Foreground="{DynamicResource KidWallTextBrush}"
    Icon="avares://KidWall.App/Assets/logo.ico"
    FontFamily="Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif"
    Height="820"
    MinHeight="640"
    MinWidth="1000"
    Title="{Binding WindowTitle}"
    Width="1280"
    TitleBarHeight="60"
    TitleBarBackground="{DynamicResource KidWallTitlebarBrush}"
    TitleBarForeground="{DynamicResource KidWallTextBrush}"
    TitleBarBorderBrush="{DynamicResource KidWallAccentGradientBrush}"
    TitleBarBorderThickness="0,0,0,3"
    behaviors:WindowCloseBehavior.IsEnabled="True"
    WindowStartupLocation="CenterScreen">
  <codewf:CodeWFWindow.LeftContent>
    <!-- 品牌区 -->
    <StackPanel
        Margin="16,0,0,0"
        Orientation="Horizontal"
        Spacing="10"
        VerticalAlignment="Center">
      <Border Classes="brand-mark" x:Name="PART_BrandMark">
        <TextBlock
            HorizontalAlignment="Center"
            Text="🎈"
            VerticalAlignment="Center" />
      </Border>
      <StackPanel Spacing="1" VerticalAlignment="Center" MaxWidth="250">
        <TextBlock Classes="win-title" Text="{Binding WindowTitle}" />
        <TextBlock Classes="win-subtitle" Text="{Binding WindowSubtitle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </StackPanel>
  </codewf:CodeWFWindow.LeftContent>
  <codewf:CodeWFWindow.TitleBarContent>
    <Grid Width="220" VerticalAlignment="Center">
      <TextBox Classes="search" Padding="34,4,10,4" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{Binding SearchPlaceholder}" />
      <TextBlock Margin="12,0,0,0" Text="🔎" IsHitTestVisible="False" VerticalAlignment="Center" />
    </Grid>
  </codewf:CodeWFWindow.TitleBarContent>
  <codewf:CodeWFWindow.RightContent>
    <!-- 搜索框与右侧操作区 -->
    <StackPanel
        Margin="0,0,10,0"
        Orientation="Horizontal"
        Spacing="8"
        VerticalAlignment="Center">
      <views:AppearanceView DataContext="{Binding Appearance}" />
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="secondary-btn" Width="32" Height="32" Padding="6" Command="{Binding PickLocalFolderCommand}" ToolTip.Tip="{Binding LocalButtonText}" AutomationProperties.Name="{Binding LocalButtonText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📁" />
          </StackPanel>
        </Button>
        <Button Classes="primary-btn" Width="32" Height="32" Padding="6" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{Binding SettingsButtonText}" AutomationProperties.Name="{Binding SettingsButtonText}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="⚙" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </codewf:CodeWFWindow.RightContent>
  <Panel>
    <Grid>

      <!-- ================= 内容区 ================= -->
      <ScrollViewer
          Effect="{Binding IsSettingsOpen, Converter={StaticResource BooleanToBlurEffectConverter}}"
          HorizontalContentAlignment="Center"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
        <views:MainView />
      </ScrollViewer>

      <!-- ================= 预览层 ================= -->
      <Border
              IsHitTestVisible="{Binding IsPreviewOpen}"
              Opacity="{Binding IsPreviewOpen, Converter={StaticResource BooleanToOpacityConverter}}"
              Background="#990A1628"
              ZIndex="300">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
          </Transitions>
        </Border.Transitions>
        <Grid>
          <Button
              Background="Transparent"
              BorderThickness="0"
              Command="{Binding ClosePreviewCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
          <Border
              Classes="surface-panel"
              HorizontalAlignment="Center"
              Margin="0,16,0,0"
              Opacity="{Binding IsPreviewOpen, Converter={StaticResource BooleanToOpacityConverter}}"
              RenderTransform="{Binding IsPreviewOpen, Converter={StaticResource BooleanToTransformConverter}, ConverterParameter=preview}"
              RenderTransformOrigin="50%,50%"
              Width="920"
              ZIndex="1">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
              </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto,Auto">
              <Border
                  Grid.Row="0"
                  Height="518"
                  Margin="18,54,18,10"
                  Background="#12000000"
                  BorderBrush="{DynamicResource KidWallBorderBrush}"
                  BorderThickness="1"
                  ClipToBounds="True"
                  CornerRadius="20">
                <Grid>
                  <controls:DynamicWallpaperPreviewView
                      Margin="8"
                      MediaPath="{Binding PreviewItem.PreviewMediaPath}"
                      PosterSource="{Binding PreviewItem.Preview}"
                      AutoPlay="{Binding PreviewItem.IsDynamic}"
                      EnableHoverPreview="False"
                      Loop="True" />
                  <Border
                      Background="{DynamicResource CardShadeBrush}"
                      Height="82"
                      VerticalAlignment="Bottom" />
                  <Border
                      Classes="badge"
                      IsVisible="{Binding PreviewItem.IsDynamic}"
                      Margin="16"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Classes="badge-dot" VerticalAlignment="Center" />
                      <TextBlock Classes="badge" Text="{Binding DynamicBadgeText}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Grid
                  Grid.Row="1"
                  Margin="18,0,18,18"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="panel-title" Text="{Binding PreviewItem.Name}" />
                  <TextBlock Classes="panel-sub" Text="{Binding PreviewItem.DisplayTags}" />
                  <TextBlock Classes="panel-sub" Text="{Binding PreviewResolution}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="secondary-btn"
                    Command="{Binding ToggleFavoriteCommand}"
                    CommandParameter="{Binding PreviewItem}">
                  <TextBlock Text="{Binding PreviewItem.FavoriteText}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Classes="primary-btn"
                    Command="{Binding ApplyWallpaperCommand}"
                    CommandParameter="{Binding PreviewItem}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="✨" />
                    <TextBlock Text="{Binding ApplyWallpaperText}" />
                  </StackPanel>
                </Button>
              </Grid>
              <!-- 为关闭按钮预留标题区，避免被原生视频窗口遮挡。 -->
              <Button
                  Grid.RowSpan="2"
                  Classes="candy hand"
                  Command="{Binding ClosePreviewCommand}"
                  CornerRadius="17"
                  Height="34"
                  HorizontalAlignment="Right"
                  Margin="0,8,16,0"
                  VerticalAlignment="Top"
                  Width="34"
                  ZIndex="10">
                <TextBlock FontSize="13" Text="✕" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ================= 设置层 ================= -->
      <Border
              IsHitTestVisible="{Binding IsSettingsOpen}"
              Opacity="{Binding IsSettingsOpen, Converter={StaticResource BooleanToOpacityConverter}}"
              Background="#660A1628"
          ZIndex="250">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
          </Transitions>
        </Border.Transitions>
        <Grid>
          <Button
              Background="Transparent"
              BorderThickness="0"
              Command="{Binding ToggleSettingsCommand}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
          <Border
              Classes="surface-panel"
              CornerRadius="18,0,0,18"
              HorizontalAlignment="Right"
              Margin="0"
              RenderTransform="{Binding IsSettingsOpen, Converter={StaticResource BooleanToTransformConverter}, ConverterParameter=drawer}"
              RenderTransformOrigin="100%,50%"
              Width="400"
              ZIndex="1">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" />
              </Transitions>
            </Border.Transitions>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,22">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="panel-title" Text="{Binding SettingsTitle}" />
                <Button
                    Grid.Column="1"
                    Classes="secondary-btn"
                    Command="{Binding ToggleSettingsCommand}"
                    Padding="8,4"
                    ToolTip.Tip="{codewf:I18n {x:Static l:Host.CloseSettings}}">
                  <TextBlock Text="✕" />
                </Button>
              </Grid>
              <TextBlock
                  Classes="panel-sub"
                  Margin="0,4,0,20"
                  Text="{Binding SettingsSubtitle}" />

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding AutoStartTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding AutoStartDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding AutoStart, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding AutoRotateTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding AutoRotateDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding AutoRotate, Mode=TwoWay}"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding BatterySaverTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding BatterySaverDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="False" IsEnabled="False"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting-title" Text="{Binding ContentFilterTitle}" />
                  <TextBlock Classes="setting-desc" Text="{Binding ContentFilterDesc}" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="False" IsEnabled="False"
                    OnContent=""
                    OffContent="" />
              </Grid>

              <Button
                  Classes="primary-btn"
                  HorizontalAlignment="Stretch"
                  Margin="0,28,0,0"
                  Command="{Binding SaveSettingsCommand}">
                <TextBlock Text="{Binding SaveSettingsText}" />
              </Button>

              <Button Command="{Binding ShowAboutCommand}" Content="{codewf:I18n {x:Static l:About.Title}}"
                      HorizontalAlignment="Stretch" Margin="0,16,0,0" />
            </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <!-- ================= 消息提示 ================= -->
      <Border
              IsHitTestVisible="{Binding IsStatusVisible}"
              Opacity="{Binding IsStatusVisible, Converter={StaticResource BooleanToOpacityConverter}}"
              RenderTransform="{Binding IsStatusVisible, Converter={StaticResource BooleanToTransformConverter}, ConverterParameter=toast}"
              RenderTransformOrigin="50%,100%"
          Background="#E6140C3C"
          BorderBrush="{DynamicResource KidWallAccentBrush}"
          BorderThickness="1"
          CornerRadius="20"
          HorizontalAlignment="Center"
          Padding="20,10"
          VerticalAlignment="Bottom"
          ZIndex="400">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" />
          </Transitions>
        </Border.Transitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border
              Background="{DynamicResource ToastTickBrush}"
              CornerRadius="11"
              Height="22"
              VerticalAlignment="Center"
              Width="22">
            <TextBlock
                FontSize="12"
                FontWeight="Bold"
                Foreground="#006633"
                HorizontalAlignment="Center"
                Text="✓"
                VerticalAlignment="Center" />
          </Border>
          <TextBlock
              FontSize="13"
              Foreground="White"
              Text="{Binding StatusMessage}"
              VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Canvas
        x:Name="PART_ParticleLayer"
        IsHitTestVisible="False"
        ZIndex="500" />
  </Panel>
</codewf:CodeWFWindow>
