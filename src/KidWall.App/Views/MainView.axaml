<UserControl
    x:Class="KidWall.App.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KidWall.App.Controls"
    xmlns:vm="using:KidWall.App.ViewModels"
    x:CompileBindings="True"
    x:DataType="vm:MainViewModel">
  <Grid Margin="26,20,26,18" RowDefinitions="Auto,Auto,*,Auto">

    <!-- ================= 分类 ================= -->
    <ItemsControl Grid.Row="0" ItemsSource="{Binding Categories}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:CategoryItemViewModel">
          <Button
              Margin="0,0,8,8"
              Background="{Binding BackgroundBrush}"
              Command="{Binding SelectCommand}"
              CornerRadius="16"
              FontSize="13"
              Foreground="{Binding ForegroundBrush}"
            Padding="15,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
              <Border
                  Background="{Binding CountBackgroundBrush}"
                  Classes="category-count"
                  VerticalAlignment="Center">
                <TextBlock
                    Classes="category-count"
                    Foreground="{Binding ForegroundBrush}"
                    HorizontalAlignment="Center"
                    Text="{Binding CountText}" />
              </Border>
              <Border
                  Classes="category-planned"
                  IsVisible="{Binding IsPlanned}"
                  VerticalAlignment="Center">
                <TextBlock Classes="category-planned" Text="{Binding PlannedText}" />
              </Border>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ================= 节标题 ================= -->
    <Grid
        Grid.Row="1"
        ColumnDefinitions="Auto,*,Auto"
        Margin="0,14,0,14">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Classes="section-badge" />
        <TextBlock FontSize="17" Text="{Binding SectionIcon}" VerticalAlignment="Center" />
        <TextBlock Classes="section-title" Text="{Binding SectionTitle}" />
      </StackPanel>
      <TextBlock
          Grid.Column="2"
          Classes="section-count"
          Text="{Binding CountText}"
          VerticalAlignment="Center" />
    </Grid>

    <!-- ================= 壁纸网格 ================= -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Wallpapers}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:WallpaperItemViewModel">
            <Border Classes="card" Margin="0,0,20,20">
              <Grid>
                <controls:DynamicWallpaperPreviewView
                    Margin="2"
                    MediaPath="{Binding PreviewMediaPath}"
                    PosterSource="{Binding Thumb}"
                    AutoPlay="{Binding IsDynamic}"
                    EnableHoverPreview="False"
                    PreviewCommand="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenPreviewCommand, Mode=OneTime}"
                    ApplyCommand="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ApplyWallpaperCommand, Mode=OneTime}"
                    CommandParameter="{Binding Mode=OneTime}"
                    PreviewText="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PreviewButtonText, Mode=OneTime}"
                    ApplyText="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SetWallpaperButtonText, Mode=OneTime}"
                    CurrentText="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CurrentBadgeText, Mode=OneTime}"
                    DynamicText="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DynamicBadgeText, Mode=OneTime}"
                    Loop="True">
                  <controls:DynamicWallpaperPreviewView.OverlayContent>
                    <controls:DynamicCardOverlay
                        IsVisible="{Binding IsDynamic}" />
                  </controls:DynamicWallpaperPreviewView.OverlayContent>
                </controls:DynamicWallpaperPreviewView>
                <Border Classes="dyn-overlay" IsVisible="{Binding IsDynamic}" />
                <Border Background="{DynamicResource CardShadeBrush}" />
                <!-- Keep the rounded card edge visible above media content. -->
                <Border
                    Background="Transparent"
                    BorderBrush="{DynamicResource KidWallBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    IsHitTestVisible="False" />
                <Border
                    Background="#88000000"
                    CornerRadius="18"
                    IsHitTestVisible="False"
                    IsVisible="{Binding IsDynamic}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="42"
                    Height="42">
                  <TextBlock
                      FontSize="19"
                      Foreground="White"
                      HorizontalAlignment="Center"
                      Text="▶"
                      VerticalAlignment="Center" />
                </Border>

                <!-- 整卡点击打开预览（透明覆盖层，ops 按钮在其上层仍可点击） -->
                <Button
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenPreviewCommand}"
                    CommandParameter="{Binding}"
                    HorizontalAlignment="Stretch"
                    Padding="0"
                    VerticalAlignment="Stretch" />

                <!-- 左上角徽标 -->
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Top">
                  <Border Classes="badge" IsVisible="{Binding IsCurrent}">
                    <TextBlock Classes="badge" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CurrentBadgeText}" />
                  </Border>
                  <Border Classes="badge" IsVisible="{Binding IsDynamic}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Classes="badge-dot" VerticalAlignment="Center" />
                      <TextBlock Classes="badge" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DynamicBadgeText}" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- 底部信息 -->
                <StackPanel
                    Margin="14,20,14,10"
                    Spacing="2"
                    VerticalAlignment="Bottom">
                  <TextBlock Classes="card-name" Text="{Binding Name}" />
                  <TextBlock Classes="card-tag" Text="{Binding DisplayTags}" />
                </StackPanel>

                <!-- 悬停操作 -->
                <StackPanel
                    Margin="0,0,10,10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Bottom">
                  <Button
                      Classes="card-ops"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenPreviewCommand}"
                      CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock FontSize="11" Text="👁" />
                      <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PreviewButtonText}" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="card-ops set"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ApplyWallpaperCommand}"
                      CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock FontSize="11" Text="✨" />
                      <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SetWallpaperButtonText}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ================= 空状态 ================= -->
    <StackPanel
        Grid.Row="3"
        HorizontalAlignment="Center"
        IsVisible="{Binding ShowEmpty}"
        Margin="0,50,0,0"
        Spacing="8">
      <TextBlock FontSize="46" HorizontalAlignment="Center" Text="🔭" />
      <TextBlock Classes="section-count" Text="{Binding EmptyText}" />
    </StackPanel>
    <StackPanel
        Grid.Row="3"
        HorizontalAlignment="Center"
        IsVisible="{Binding ShowDynamicPlanned}"
        Margin="0,50,0,0"
        Spacing="8">
      <TextBlock FontSize="46" HorizontalAlignment="Center" Text="🎞️" />
      <TextBlock Classes="section-count" Text="{Binding DynamicPlannedText}" />
    </StackPanel>
  </Grid>
</UserControl>
