<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KidWall.App.ViewModels"
             xmlns:codewf="https://codewf.com"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:keys="using:Localization"
             x:Class="KidWall.App.Views.AppearanceView" x:DataType="vm:AppearanceViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.title-palettes ListBoxItem">
      <Setter Property="Width" Value="24" /><Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="4" /><Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.title-palettes ListBoxItem:selected"><Setter Property="BorderBrush" Value="{DynamicResource KidWallAccentBrush}" /></Style>
  </UserControl.Styles>
  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
    <ListBox Classes="title-palettes" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette, Mode=TwoWay}"
             Background="Transparent" BorderThickness="0" Padding="0" Height="28" ToolTip.Tip="{Binding PaletteLabel}">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate x:DataType="vm:AppearanceOption"><Ellipse Width="14" Height="14" Fill="{Binding Swatch}" ToolTip.Tip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}" /></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ThemeVariantScope x:Name="TitleBarThemeScope" RequestedThemeVariant="{Binding ThemeMode, Mode=TwoWay, Converter={x:Static codewf:StudioThemeModeConverter.Instance}}">
      <ThemeVariantScope.Resources>
        <TextBlock x:Key="STRING_THEME_TOGGLE_SYSTEM" Text="{codewf:I18n {x:Static keys:Appearance.System}}" />
        <TextBlock x:Key="STRING_THEME_TOGGLE_LIGHT" Text="{codewf:I18n {x:Static keys:Appearance.Light}}" />
        <TextBlock x:Key="STRING_THEME_TOGGLE_DARK" Text="{codewf:I18n {x:Static keys:Appearance.Dark}}" />
      </ThemeVariantScope.Resources>
      <ursa:ThemeToggleButton Width="30" Height="30" IsThreeState="True" TargetScope="{Binding #TitleBarThemeScope}" ToolTip.Tip="{Binding ThemeLabel}" />
    </ThemeVariantScope>
    <Button Width="30" Height="30" Padding="6" Background="Transparent" ToolTip.Tip="{Binding LanguageLabel}" AutomationProperties.Name="{Binding LanguageLabel}">
      <PathIcon Width="17" Height="17" Data="{StaticResource SemiIconLanguage}" />
      <Button.Flyout><MenuFlyout ItemsSource="{Binding Languages}">
        <MenuFlyout.ItemContainerTheme><ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:LanguageOption">
          <Setter Property="Header" Value="{Binding DisplayName}" /><Setter Property="Command" Value="{Binding SelectCommand}" />
        </ControlTheme></MenuFlyout.ItemContainerTheme>
      </MenuFlyout></Button.Flyout>
    </Button>
  </StackPanel>
</UserControl>
