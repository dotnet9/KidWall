<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>KidWall.App</RootNamespace>
    <AssemblyName>KidWall.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Lang.Avalonia" />
    <PackageReference Include="Lang.Avalonia.Json" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Semi.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidWall.Core\KidWall.Core.csproj" />
  </ItemGroup>

  <!-- 仓库根目录 res/ 壁纸资源：目录链接引用，编译时输出到 res/ -->
  <ItemGroup>
    <None Include="..\..\res\**\*" Link="res\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 根目录 logo 资源：保留源文件在仓库根目录，引用时挂到 Assets/ 下 -->
  <ItemGroup>
    <AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="I18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    I18n 强类型 Key：由 I18n/Language.tt（T4 模板）根据 zh-CN.json 生成 I18n/Language.cs。
    Language.cs 已提交入库，直接作为普通编译文件使用；修改 JSON 后在 VS 中运行 T4 可重新生成。
  -->
</Project>
