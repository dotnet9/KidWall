<Application
    x:Class="KidWall.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:KidWall.App"
    xmlns:converters="using:KidWall.App.Converters"
    xmlns:views="using:KidWall.App.Views"
    xmlns:vm="using:KidWall.App.ViewModels"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:codewf="https://codewf.com"
    xmlns:l="using:Localization"
    x:DataType="app:App"
    RequestedThemeVariant="Dark">
  <Application.Resources>
    <converters:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
    <converters:BooleanToTransformConverter x:Key="BooleanToTransformConverter" />
    <converters:BooleanToBlurEffectConverter x:Key="BooleanToBlurEffectConverter" />
  </Application.Resources>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:MainViewModel">
      <views:MainView />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <semi:UrsaSemiTheme Locale="zh-CN" />
    <semi:SemiPopupAnimations />
    <codewf:ACSemiTheme />
    <codewf:StudioTheme />
    <StyleInclude Source="avares://KidWall.App/Styles/Index.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon
          Command="{Binding TrayIconCommand}"
          Icon="avares://KidWall.App/Assets/logo.ico"
          ToolTipText="{codewf:I18n Localization.Shell.Window.Title}">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="{codewf:I18n {x:Static l:Host.TrayOpen}}" Command="{Binding ShowMainWindowCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="{codewf:I18n {x:Static l:Host.TrayExit}}" Command="{Binding ExitApplicationCommand}" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
