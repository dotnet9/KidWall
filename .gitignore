## Ignore Visual Studio temporary files, build results, and generated files.

# User-specific files
*.suo
*.user
*.userosscache
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
TestResults/
*.trx
*.binlog

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*

# IDE
.vs/
.vscode/*
!.vscode/settings.json
.idea/
*.DotSettings.user

# Runtime generated
*.cache
*.log
*.tmp

# Local run screenshots (not part of the repo)
design/app-screenshot*.png

